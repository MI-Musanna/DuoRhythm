<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass_oled"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDownloadTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Downloading app update..."
        android:textColor="#F8FAFC"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDownloadProgressDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0% (0.00 MB / 0.00 MB)"
        android:textColor="#94A3B8"
        android:textSize="12.5sp" />

    <!-- Live Horizontal Progress Bar -->
    <ProgressBar
        android:id="@+id/pbDownloadHorizontal"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#00E5FF" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDownload"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Cancel"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstallDownloadedApk"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="#00E5FF"
            android:text="INSTALL NOW"
            android:textColor="#06080F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="20dp" />
    </LinearLayout>
</LinearLayout>
