<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:elevation="8dp"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Subject Section"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etSubjectName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Subject Name (e.g. Mathematics)"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?android:attr/textColorSecondary"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etSubjectCode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Subject Code (e.g. 101)"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?android:attr/textColorSecondary"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etCredits"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="number"
            android:hint="Credits (e.g. 3)"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?android:attr/textColorSecondary" />
    </LinearLayout>

    <EditText
        android:id="@+id/etInstructor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Instructor (Optional)"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?android:attr/textColorSecondary"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSubject"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="CREATE SUBJECT SECTION" />
</LinearLayout>
