<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass_oled"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_update_sparkle"
            app:tint="#00E5FF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Software Releases"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseUpdateDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="#64748B" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Choose your preferred DuoRhythm release track:"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <!-- Stable Channel Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStableTrack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#131B2E"
        app:cardCornerRadius="14dp"
        app:strokeColor="#1E293B"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStableLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Official Stable Channel"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStableVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvStableLabel"
                android:layout_marginTop="3dp"
                android:text="Verified Stable"
                android:textColor="#10B981"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstallStable"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="#10B981"
                android:text="Switch"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="18dp" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Banner shown when repo has no stable releases yet -->
    <TextView
        android:id="@+id/tvNoStableBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_dark"
        android:padding="12dp"
        android:text="ℹ️ Official Stable track will unlock with v1.0.0 milestone. You are currently on the bleeding-edge Beta channel."
        android:textColor="#64748B"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <!-- Beta / Preview Channel Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBetaTrack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#131B2E"
        app:cardCornerRadius="14dp"
        app:strokeColor="#00E5FF"
        app:strokeWidth="1.5dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvBetaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beta / Preview Channel"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBetaVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvBetaLabel"
                android:layout_marginTop="3dp"
                android:text="v1.0.2-beta • Currently Installed"
                android:textColor="#00E5FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/badgeBetaInstalled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_widget_pill_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="INSTALLED"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
