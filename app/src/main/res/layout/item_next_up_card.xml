<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="2dp"
    app:cardBackgroundColor="#131B2E"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#1F2F4D"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <!-- Calendar Icon Box -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button_dark">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Class Schedule"
                android:src="@drawable/ic_schedule"
                app:tint="#00E5FF" />
        </FrameLayout>

        <!-- Schedule Button (Right Side) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSchedule"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="Schedule →"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            app:cornerRadius="17dp"
            app:strokeColor="#243859"
            app:strokeWidth="1dp" />

        <!-- Count Indicator (e.g. 1 of 3) -->
        <TextView
            android:id="@+id/tvCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:textColor="#64748B"
            android:textSize="9.5sp" />

        <!-- Center Content (Subject, Time, Chips) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btnSchedule"
            android:layout_toEndOf="@id/iconContainer"
            android:orientation="vertical">

            <!-- Tags / Status Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_widget_pill_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="NEXT UP"
                    android:textColor="#00E5FF"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_widget_pill_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="LECTURE"
                    android:textColor="#38BDF8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subject Title -->
            <TextView
                android:id="@+id/tvSubjectTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- Time and Room -->
            <TextView
                android:id="@+id/tvTimeRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>