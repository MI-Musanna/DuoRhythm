<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_dark"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Export Timetable"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Live Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#0B1120"
        app:cardCornerRadius="12dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivScheduleThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Live Schedule Preview" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchSelectAllDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="Select All Working Days"
        android:textColor="#E2E8F0"
        android:textSize="14sp"
        app:useMaterialThemeColors="true" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:chipSpacing="6dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSat"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Sat"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="@color/bg_chip_selector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSun"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Sun"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="@color/bg_chip_selector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMon"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Mon"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="@color/bg_chip_selector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTue"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Tue"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="@color/bg_chip_selector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipWed"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Wed"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="@color/bg_chip_selector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipThu"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Thu"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="@color/bg_chip_selector" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelScheduleExport"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            android:textColor="#94A3B8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareSchedule"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:strokeColor="#00E5FF"
            android:text="SHARE"
            android:textColor="#00E5FF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:backgroundTint="#00E5FF"
            android:text="SAVE"
            android:textColor="#0F172A"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
