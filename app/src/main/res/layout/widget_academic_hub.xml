<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card_dark_elevated"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header: Clean Brand Title, Sync Time, and Enlarged 42dp Refresh Hitbox -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DUORHYTHM • ACADEMIC HUB"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetSyncTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="#64748B"
            android:textSize="10sp" />

        <!-- Large 42x42dp Clickable Container to Prevent Miss-Touch -->
        <FrameLayout
            android:id="@+id/btnWidgetRefreshHitbox"
            android:layout_width="42dp"
            android:layout_height="32dp">

            <ImageView
                android:id="@+id/ivWidgetRefreshIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Refresh Widget"
                android:src="@drawable/ic_refresh" />

            <ProgressBar
                android:id="@+id/pbWidgetLoading"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#00E5FF"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Main Content Container: Fluid Adaptive Grid -->
    <LinearLayout
        android:id="@+id/layoutMainGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Column 1: Classes Section (Collapsible / Expandable) -->
        <LinearLayout
            android:id="@+id/layoutScheduleSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvClassHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TODAY • CLASSES"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Class Item 1 -->
            <LinearLayout
                android:id="@+id/rowClass1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvClass1Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvClass1Details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Class Item 2 -->
            <LinearLayout
                android:id="@+id/rowClass2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvClass2Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvClass2Details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoClasses"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="No lectures scheduled"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Dynamic Gap between Columns -->
        <FrameLayout
            android:id="@+id/layoutColumnGap"
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!-- Column 2: Exams Section (Collapsible / Expandable) -->
        <LinearLayout
            android:id="@+id/layoutExamSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvExamHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UPCOMING EXAMS"
                android:textColor="#F59E0B"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Exam Item 1 -->
            <LinearLayout
                android:id="@+id/rowExam1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExam1Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExam1Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F59E0B"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExam1Details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Exam Item 2 -->
            <LinearLayout
                android:id="@+id/rowExam2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExam2Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExam2Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F59E0B"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExam2Details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoExams"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="All clear! No exams"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
