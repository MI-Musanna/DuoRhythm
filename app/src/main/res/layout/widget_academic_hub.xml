<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget_glass_oled"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Bar: Prominent 36sp Central Digital Clock -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Centered Live Clock Touchpad -->
        <LinearLayout
            android:id="@+id/layoutClockTouchpad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/tcWidgetClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextClock
                    android:id="@+id/tcWidgetAmPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:format12Hour="a"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextClock
                android:id="@+id/tcWidgetDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:format12Hour="EEEE, MMMM d"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Side: Interactive Refresh Button -->
        <FrameLayout
            android:id="@+id/btnWidgetRefreshHitbox"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/ivWidgetRefreshIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Refresh"
                android:src="@drawable/ic_refresh" />

            <ProgressBar
                android:id="@+id/pbWidgetLoading"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#00E5FF"
                android:visibility="gone" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Main Content Container: Snug Floating Micro-Cards -->
    <LinearLayout
        android:id="@+id/layoutMainGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Column 1: Classes Section -->
        <LinearLayout
            android:id="@+id/layoutScheduleSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClassHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="TODAY • LECTURES"
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <!-- Class Tile 1 -->
            <LinearLayout
                android:id="@+id/rowClass1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_widget_item_class"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvClass1Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_pill_badge"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1.5dp"
                        android:text="NEXT UP"
                        android:textColor="#00E5FF"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvClass1Room"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_pill_badge"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1.5dp"
                        android:textColor="#38BDF8"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvClass1Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvClass1Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Class Tile 2 -->
            <LinearLayout
                android:id="@+id/rowClass2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_item_class"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvClass2Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_pill_badge"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1.5dp"
                        android:text="UPCOMING"
                        android:textColor="#64748B"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvClass2Room"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_pill_badge"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1.5dp"
                        android:textColor="#38BDF8"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvClass2Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvClass2Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoClasses"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_widget_item_class"
                android:gravity="center"
                android:text="No upcoming lectures"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Vertical Divider Line -->
        <FrameLayout
            android:id="@+id/vSectionDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="7dp"
            android:background="#2E38BDF8" />

        <!-- Column 2: Exams Section -->
        <LinearLayout
            android:id="@+id/layoutExamSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExamHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="UPCOMING EXAMS"
                android:textColor="#F59E0B"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <!-- Exam Tile 1 -->
            <LinearLayout
                android:id="@+id/rowExam1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_widget_item_exam"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExam1Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_pill_badge"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1.5dp"
                        android:textColor="#F59E0B"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvExam1Room"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_pill_badge"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1.5dp"
                        android:textColor="#F59E0B"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExam1Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExam1Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Exam Tile 2 -->
            <LinearLayout
                android:id="@+id/rowExam2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_item_exam"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExam2Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_pill_badge"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1.5dp"
                        android:textColor="#F59E0B"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvExam2Room"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_pill_badge"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1.5dp"
                        android:textColor="#F59E0B"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExam2Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExam2Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoExams"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_widget_item_exam"
                android:gravity="center"
                android:text="All clear! No pending exams"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>