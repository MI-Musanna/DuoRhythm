<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <!-- Category Color Icon Circle -->
    <ImageView
        android:id="@+id/ivManageCategoryIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_category_icon_circle"
        android:padding="8dp"
        android:src="@drawable/ic_tasks"
        app:tint="@color/white" />

    <!-- Name and Type -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvManageCategoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvManageCategoryType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Edit Action -->
    <ImageButton
        android:id="@+id/btnManageCategoryEdit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Edit Category"
        android:padding="8dp"
        android:src="@drawable/ic_edit"
        app:tint="@color/text_secondary" />

    <!-- Delete Action -->
    <ImageButton
        android:id="@+id/btnManageCategoryDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete Category"
        android:padding="8dp"
        android:src="@drawable/ic_delete"
        app:tint="#EF4444" />

</LinearLayout>
