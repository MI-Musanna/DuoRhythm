<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDayCell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="15" />

    <!-- Horizontal Multi-Dot Indicators (Side-by-side with zero overlap) -->
    <LinearLayout
        android:id="@+id/layoutDotIndicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Attendance Dot: Green (Present), Red (Absent), Cyan (Scheduled) -->
        <View
            android:id="@+id/dotAttendance"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_circle_dot"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Subscription Dot: Amber (#F59E0B) -->
        <View
            android:id="@+id/dotSubscription"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_circle_dot"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
