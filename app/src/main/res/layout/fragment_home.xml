<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="96dp"
    android:background="@drawable/bg_ambient_canvas">

    <LinearLayout
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Header: Minimal Avatar Pill + "Welcome back" + Compact Mode Switch Capsule -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_specular_edge"
            android:clipToOutline="true"
            android:clipToPadding="true"
            android:clipChildren="true"
            android:outlineProvider="background"
            android:elevation="0dp"
            app:blurOverlayColor="@color/blur_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header Top Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Stylish User Profile Avatar Badge (Replaces duplicate app icon) -->
                    <FrameLayout
                        android:id="@+id/containerHomeAvatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivUserAvatar"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:padding="8dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/neon_cyan"
                            android:contentDescription="User Profile" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/layoutUserInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical">

                        <!-- Top Label -->
                        <TextView
                            android:id="@+id/tvHomeGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Welcome back,"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- User Name Label -->
                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scholar"
                            tools:text="Scholar"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Date Label -->
                        <TextView
                            android:id="@+id/tvHomeLiveDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Wednesday, October 14"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Enclosed Unified Student/Work Pill -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_toggle_container"
                        android:clipToPadding="true"
                        android:clipChildren="true"
                        android:padding="4dp">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleHomeProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            app:checkedButton="@id/btnHomeProfileStudent"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnHomeProfileStudent"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:minHeight="32dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="0dp"
                                android:text="Student"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:backgroundTint="#0284C7"
                                app:strokeWidth="0dp"
                                app:cornerRadius="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnHomeProfileWork"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:minHeight="32dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="0dp"
                                android:text="Work"
                                android:textColor="#475569"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:backgroundTint="@android:color/transparent"
                                app:strokeWidth="0dp"
                                app:cornerRadius="16dp" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

        <!-- Section Title: Next Up -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Next Up"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 2. Next Up Hub: Single Floating Glass Card with Internal Timetable Badge -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardHomeSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_specular_edge"
            android:clipToOutline="true"
            android:clipToPadding="true"
            android:clipChildren="true"
            android:outlineProvider="background"
            android:clickable="true"
            android:focusable="true"
            android:elevation="0dp"
            app:blurOverlayColor="@color/blur_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Squircle Icon Capsule -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_glass_squircle_action">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_schedule"
                        app:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHomeScheduleSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Classes Today"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_timetable"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            android:text="TIMETABLE"
                            android:textColor="@color/primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHomeScheduleSubtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="All clear • Timetable on track"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_action_pill_cyan"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Schedule →"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

        <!-- Section Title: Overview -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Overview"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 3. 2-Column Asymmetric Metric Deck: Finance + Missions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="true"
            android:clipChildren="true"
            android:orientation="horizontal">

            <!-- Finance Card (Left Column) -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardHomeWallet"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_glass_specular_edge"
                android:clipToOutline="true"
                android:clipToPadding="true"
                android:clipChildren="true"
                android:outlineProvider="background"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp"
                app:blurOverlayColor="@color/blur_overlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_wallet"
                            app:tint="#00F2FE" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Finance"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHomeBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0.00"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHomeIncomeExpenseBrief"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="+0.00 / -0.00"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <!-- Electric Cyan Bezier Sparkline with Translucent Gradient Underfill -->
                    <com.duorhythm.app.ui.home.SparklineTrendView
                        android:id="@+id/sparklineHomeBalance"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <!-- Missions Card (Right Column) -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardHomeTasks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1.0"
                android:background="@drawable/bg_glass_specular_edge"
                android:clipToOutline="true"
                android:clipToPadding="true"
                android:clipChildren="true"
                android:outlineProvider="background"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp"
                app:blurOverlayColor="@color/blur_overlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_tasks"
                            app:tint="#D946EF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Missions"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Circular Progress Ring with Electric Glow -->
                        <com.duorhythm.app.ui.home.CircularProgressRingView
                            android:id="@+id/progressRingHomeTasks"
                            android:layout_width="44dp"
                            android:layout_height="44dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHomeTasksCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Pending"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHomeTasksPriorityBrief"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="All clear"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

        </LinearLayout>

        <!-- 4. Scratchpad / Quick Notes Bento Card -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardHomeQuickNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_specular_edge"
            android:clipToOutline="true"
            android:clipToPadding="true"
            android:clipChildren="true"
            android:outlineProvider="background"
            android:elevation="0dp"
            app:blurOverlayColor="@color/blur_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_edit_note"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Scratchpad / Quick Notes"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeAddNote"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="+ Quick Note"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_action_pill_cyan" />
                </LinearLayout>

                <!-- RecyclerView for Notes (Horizontal scroll wrapped in NestedScrollableHost) -->
                <com.duorhythm.app.ui.common.NestedScrollableHost
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHomeQuickNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_quick_note_home" />
                </com.duorhythm.app.ui.common.NestedScrollableHost>

                <!-- Empty State -->
                <TextView
                    android:id="@+id/tvEmptyHomeQuickNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_scratchpad_field"
                    android:padding="14dp"
                    android:text="Tap + Quick Note to jot down lecture formulas, ideas, or quick memos."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

        <!-- 5. Portal Card (Study / Work Portal Hub) -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardHomePortal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_specular_edge"
            android:clipToOutline="true"
            android:clipToPadding="true"
            android:clipChildren="true"
            android:outlineProvider="background"
            android:clickable="true"
            android:focusable="true"
            android:elevation="0dp"
            app:blurOverlayColor="@color/blur_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/badgeHomePortal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_squircle_portal_student">

                    <ImageView
                        android:id="@+id/ivHomePortalIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_portal"
                        app:tint="#38BDF8" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHomePortalTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Study Portal"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHomePortalSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 Enrolled Subjects"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvHomePortalSubtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Assignments, exams, and notes"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnHomePortalAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_portal_pill_student"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Portal →"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

        <!-- Section Title: Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Quick Actions"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Minimal Action Strip (Frosted Glass Card containing 4 compact quick tools) -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/btnHomeOpenTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_specular_edge"
            android:clipToOutline="true"
            android:clipToPadding="true"
            android:clipChildren="true"
            android:outlineProvider="background"
            android:elevation="0dp"
            app:blurOverlayColor="@color/blur_overlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp"
                android:paddingHorizontal="6dp">

                <!-- Action 1: Focus -->
                <LinearLayout
                    android:id="@+id/toolHomePomodoro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_quick_action_dock">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_timer"
                            app:tint="#0284C7" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Focus"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Action 2: Sounds -->
                <LinearLayout
                    android:id="@+id/toolHomeMusic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_quick_action_dock">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_music"
                            app:tint="#9333EA" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sounds"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Action 3: Calc -->
                <LinearLayout
                    android:id="@+id/toolHomeCalc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_quick_action_dock">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_calculate"
                            app:tint="#D97706" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Calc"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Action 4: Suite -->
                <LinearLayout
                    android:id="@+id/toolHomeBackup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_quick_action_dock">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bolt"
                            app:tint="#0D9488" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Suite"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
