<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06080F"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="96dp">

        <!-- Top Profile Glass Card (Zero Black Voids, Flush & Balanced) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/surface_card_slate"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_glass_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivUserProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_button_dark"
                    android:contentDescription="Profile"
                    android:src="@drawable/ic_profile_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWelcomeUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Welcome back, Mahdi Islam Musanna"
                        android:textColor="@color/text_primary_white"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentDateHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Today"
                        android:textColor="@color/text_secondary_slate"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Symmetrical Student / Work Mode Switch Pill -->
                <LinearLayout
                    android:id="@+id/toggleStudentWork"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_pill_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/btnStudentMode"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_pill_blue"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="STUDENT"
                        android:textColor="#FFFFFF"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnWorkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="WORK"
                        android:textColor="@color/text_secondary_slate"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Next Up Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next Up"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnNextUpPrev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_button_dark"
                android:contentDescription="Previous"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left" />

            <ImageView
                android:id="@+id/btnNextUpNext"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_button_dark"
                android:contentDescription="Next"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerNextUp"
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_marginTop="8dp" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/dotsIndicatorNextUp"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:focusable="false"
            app:tabBackground="@drawable/selector_carousel_dots_clean"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabMaxWidth="12dp"
            app:tabRippleColor="@null"
            app:tabUnboundedRipple="false" />

        <TextView
            android:id="@+id/tvNoClassesScheduled"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="center"
            android:text="All lectures finished • Rest and recharge"
            android:textColor="#475569"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <!-- Symmetrical Ledger & Missions -->
        <LinearLayout
            android:id="@+id/layoutOverviewSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFinanceGlance"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#0D1322"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#18243C"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/hFin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_wallet"
                            app:tint="#38BDF8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Ledger"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFinanceBalanceMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/hFin"
                        android:layout_marginTop="6dp"
                        android:textColor="#F8FAFC"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFinanceDeltaSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:text="Net Total"
                        android:textColor="#10B981"
                        android:textSize="9.5sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMissionsGlance"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#0D1322"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#18243C"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/hMis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_checkbox_checked"
                            app:tint="#A855F7" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Missions"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeMissionRatio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_dark"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="1dp"
                            android:text="0/3"
                            android:textColor="#A855F7"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMissionsTitleCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/hMis"
                        android:layout_marginTop="6dp"
                        android:text="3 Active"
                        android:textColor="#F8FAFC"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMissionsSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:text="Tasks on agenda"
                        android:textColor="#475569"
                        android:textSize="9.5sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Study & Work Portal Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStudyPortal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#0D1322"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#18243C"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">

                <FrameLayout
                    android:id="@+id/framePortalIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_button_dark">

                    <ImageView
                        android:id="@+id/ivPortalCardIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_portal"
                        app:tint="#00E5FF" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toEndOf="@id/framePortalIcon"
                    android:layout_toStartOf="@id/btnStudyPortal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPortalCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Study Portal"
                        android:textColor="@color/text_primary_white"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEnrolledSubjectsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 Enrolled Subjects • Coursework &amp; Exams"
                        android:textColor="@color/text_secondary_slate"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStudyPortal"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:text="Portal →"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    app:cornerRadius="17dp"
                    app:strokeColor="#18243C"
                    app:strokeWidth="1dp" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scratchpad: Restored Collapsible Arrow & Note Preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickNotesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#0D1322"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#18243C"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <RelativeLayout
                    android:id="@+id/layoutScratchpadHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_notes"
                            app:tint="#00E5FF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Scratchpad"
                            android:textColor="#F8FAFC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivNotesChevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnNewQuickNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="+ NOTE"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Collapsible Container for Scratchpad Body -->
                <LinearLayout
                    android:id="@+id/layoutNotesCollapsibleBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHomeQuickNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <TextView
                        android:id="@+id/tvEmptyHomeQuickNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_dark"
                        android:padding="10dp"
                        android:text="Tap + NOTE to jot down formulas or lecture memos..."
                        android:textColor="#475569"
                        android:textSize="11.5sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvQuickNotePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_dark"
                        android:padding="10dp"
                        android:text="Tap + NOTE to jot down formulas or lecture memos..."
                        android:textColor="#475569"
                        android:textSize="11.5sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions: Symmetrical 2 Tools -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Quick Actions"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnQuickFocusTimer"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#0D1322"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#18243C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_timer"
                        app:tint="#F43F5E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Pomodoro Timer"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnQuickCalculator"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#0D1322"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#18243C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_calculator"
                        app:tint="#EAB308" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="CGPA &amp; Marks"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Hidden legacy views for ViewBinding compatibility with valid explicit layout attributes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <View
                android:id="@+id/cardHomeQuickNotes"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/layoutNotesContent"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <ImageView
                android:id="@+id/ivChevronNotes"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/btnToggleNotes"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/btnHomeAddNote"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/scrollScratchpadPreview"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvScratchpadPreview"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/layoutNextUpSection"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/layoutWorkMilestonesContainer"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/layoutStudentOverview"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/layoutWorkOverview"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/cardWorkPortal"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/cardHomePortal"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/cardHomePortalWork"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/btnHomeOpenTools"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/badgeHomePortal"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <ImageView
                android:id="@+id/ivHomePortalIcon"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/btnHomePortalAction"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/btnHomePortalWorkAction"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/cardWorkMilestones"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvHomePortalTitle"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvHomePortalSummary"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvHomePortalSubtext"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/btnPrevWorkOrder"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/btnNextWorkOrder"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/layoutActiveWorkOrder"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/layoutEmptyWorkOrders"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvDeliverablesBadge"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvWorkMilestoneTitle"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvWorkMilestoneSubtext"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvWorkMilestoneStatus"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvWorkMilestoneCountdown"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvWorkOrderCounter"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/toolHomePomodoro"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/toolHomeMusic"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <View
                android:id="@+id/toolHomeCalc"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>