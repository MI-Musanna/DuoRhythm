<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#131D2F"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#243654"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Accent Indicator Bar -->
        <View
            android:id="@+id/viewAccentIndicator"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:background="#06B6D4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Top Row: Icon Squircle + 3-Dot Options Action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/layoutBucketIconBg"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_glass_squircle_action">

                    <ImageView
                        android:id="@+id/ivBucketIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_wallet"
                        app:tint="#06B6D4" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnBucketOptions"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Account Options"
                    android:padding="2dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <!-- Account Name (Icon + Name + Balance minimalist display) -->
            <TextView
                android:id="@+id/tvBucketName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Cash"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Hidden subtitle for zero-regression ViewBinding safety -->
            <TextView
                android:id="@+id/tvBucketAccounts"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Balance Display in Prominent Bold -->
            <TextView
                android:id="@+id/tvBucketBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="$0.00"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
