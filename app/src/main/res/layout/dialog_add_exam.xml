<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvExamDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Schedule Exam"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvExamDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Assign course, exam date, room, and syllabus."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Exam Type Badge (Locked) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type: "
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvExamTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="#220284C7"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="SEMESTER FINAL"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subject Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Select Enrolled Subject"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spExamSubject"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_edit_text_dynamic" />

    <!-- Exam Title -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilExamTitle"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:boxBackgroundColor="@color/surface_variant"
        app:boxStrokeColor="@color/card_stroke_bright"
        android:hint="Exam Title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etExamTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Date & Time Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            app:boxBackgroundColor="@color/surface_variant"
            app:boxStrokeColor="@color/card_stroke_bright"
            android:hint="Exam Date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExamDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOutline" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            app:boxBackgroundColor="@color/surface_variant"
            app:boxStrokeColor="@color/card_stroke_bright"
            android:hint="Time (Optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExamTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOutline" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Room / Hall -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:boxBackgroundColor="@color/surface_variant"
        app:boxStrokeColor="@color/card_stroke_bright"
        android:hint="Room / Hall / Location (e.g. Room 402, Main Aud)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etExamRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Syllabus & Notes -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:boxBackgroundColor="@color/surface_variant"
        app:boxStrokeColor="@color/card_stroke_bright"
        android:hint="Syllabus / Topics / Notes (Optional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etExamNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveExam"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:text="Schedule Exam"
        app:cornerRadius="12dp" />

</LinearLayout>
