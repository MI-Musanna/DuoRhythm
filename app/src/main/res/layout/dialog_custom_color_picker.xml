<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="#131B2E">

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Custom Color Studio"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:text="Pinpoint shade on 2D spectrum and drag slider for hue"
            android:textColor="#94A3B8"
            android:textSize="12sp"/>

        <com.duorhythm.app.ui.views.ColorSpectrumView
            android:id="@+id/colorSpectrumView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:text="Base Hue Tone"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <SeekBar
            android:id="@+id/hueSeekBar"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:max="360"
            android:progress="200"
            android:progressDrawable="@drawable/bg_rainbow_hue"
            android:splitTrack="false"
            android:thumbTint="@android:color/white"/>

        <LinearLayout
            android:gravity="center_vertical"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:orientation="horizontal">

            <View
                android:background="@drawable/bg_circle_preview"
                android:id="@+id/viewSelectedColorPreview"
                android:layout_height="52dp"
                android:layout_width="52dp"/>

            <EditText
                android:background="@drawable/bg_edittext_curved"
                android:gravity="center_vertical"
                android:hint="#000000"
                android:id="@+id/etHexCode"
                android:inputType="textCapCharacters"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:maxLength="7"
                android:paddingHorizontal="16dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:gravity="end"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelColor"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="CANCEL"
                android:textColor="#94A3B8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyColor"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="SELECT COLOR"
                android:textColor="@android:color/black"
                app:backgroundTint="#06B6D4"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
