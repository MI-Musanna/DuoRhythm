<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root_obsidian"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_card_slate"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackBucketDetail"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button_dark"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_primary_white" />

        <TextView
            android:id="@+id/tvBucketTitleHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@id/btnBackBucketDetail"
            android:text="Account Details"
            android:textColor="@color/text_primary_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnBucketMenuOptions"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Options"
            android:padding="6dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_secondary_slate" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Primary Account Balance Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0B1220"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#3800E5FF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvBucketCategoryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT BALANCE"
                        android:textColor="@color/text_secondary_slate"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBucketBalanceAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="৳0.00"
                        android:textColor="@color/text_primary_white"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <!-- Quick Record & Transfer Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddTransaction"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="@color/accent_cyan_primary"
                            android:text="+ RECORD"
                            android:textColor="#06080F"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTransferFunds"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="TRANSFER"
                            android:textColor="@color/text_primary_white"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp"
                            app:strokeColor="@color/border_glass_stroke" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Transaction History Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvHistoryHeaderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Recent Transactions"
                    android:textColor="@color/text_primary_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvClearOrFilterHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Filter"
                    android:textColor="@color/accent_cyan_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Transactions List Container -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBucketTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvEmptyBucketHistory"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:text="No transactions recorded yet"
                android:textColor="@color/text_secondary_slate"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Legacy stub views for ViewBinding compatibility -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdjustBalanceHero"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/btnDeleteBucket"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupBucketTxFilter"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBucketAll"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBucketIncome"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBucketExpense"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </com.google.android.material.chip.ChipGroup>

        <View
            android:id="@+id/btnToggleMiniChartMode"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBucketCategory"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategoryFilter"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupLinkedMethods"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <FrameLayout
            android:id="@+id/containerBucketMiniChart"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/bucketMiniBarChart"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/bucketMiniPieChart"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <View
            android:id="@+id/layoutMiniChartEmpty"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tvMiniChartToggleIcon"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tvBucketInflow"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tvBucketOutflow"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <View
            android:id="@+id/viewBucketAccentTrim"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddBucketRecord"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>
</LinearLayout>
