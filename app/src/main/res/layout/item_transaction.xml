<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_card_slate"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_glass_stroke"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Transaction Type Icon Container -->
        <FrameLayout
            android:id="@+id/layoutIconFrame"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button_dark">

            <ImageView
                android:id="@+id/ivTransactionTypeIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Type"
                android:src="@drawable/ic_wallet"
                app:tint="@color/accent_cyan_primary" />
        </FrameLayout>

        <!-- Transaction Title and Timestamp -->
        <LinearLayout
            android:id="@+id/layoutTitleBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_toEndOf="@id/layoutIconFrame"
            android:layout_toStartOf="@id/layoutAmountBlock"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTransactionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Transaction"
                android:textColor="@color/text_primary_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTransactionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Date &amp; Time"
                android:textColor="@color/text_secondary_slate"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Amount and Type Badge -->
        <LinearLayout
            android:id="@+id/layoutAmountBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btnDeleteTransaction"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTransactionAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="৳0.00"
                android:textColor="@color/accent_emerald_work"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBalanceTrail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                android:visibility="gone"
                tools:text="৳19,650 ➔ ৳19,670" />

            <TextView
                android:id="@+id/tvTransactionCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="General"
                android:textColor="@color/text_tertiary_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Line 103 Fixed: Direct Concrete Color Tint (No Unresolved Theme Attributes) -->
        <ImageButton
            android:id="@+id/btnDeleteTransaction"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:padding="6dp"
            android:src="@drawable/ic_trash"
            app:tint="@color/text_secondary_slate" />

        <TextView
            android:id="@+id/tvRunningBalance"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
