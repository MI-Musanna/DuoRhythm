<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clipToOutline="true"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Accent Pill Bar -->
        <View
            android:id="@+id/viewCourseAccent"
            android:layout_width="4dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_rounded_accent_pill"
            app:layout_constraintBottom_toTopOf="@id/layoutDetailsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Enforce Non-Breaking Title Constraints -->
        <TextView
            android:id="@+id/tvCourseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/layoutMetaInfo"
            app:layout_constraintStart_toEndOf="@id/viewCourseAccent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Application Development Using Python" />

        <!-- Meta Info Container (Credits, Code, Actions) -->
        <LinearLayout
            android:id="@+id/layoutMetaInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvCourseCredits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_credit"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/badge_credit_text"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="3 Credits" />

            <TextView
                android:id="@+id/tvCourseCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_code"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/badge_code_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="CS-28531" />

            <ImageButton
                android:id="@+id/btnDeleteCourse"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Instructor & Attendance Details Row -->
        <LinearLayout
            android:id="@+id/layoutDetailsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvCourseTitle"
            app:layout_constraintTop_toBottomOf="@id/tvCourseTitle">

            <TextView
                android:id="@+id/tvCourseInstructor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:drawablePadding="4dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:drawableStartCompat="@drawable/ic_contacts"
                app:drawableTint="@color/text_secondary"
                tools:text="Prof. Johir Ahemmod" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCourseAttendanceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/badge_neutral_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="85% Attendance" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
