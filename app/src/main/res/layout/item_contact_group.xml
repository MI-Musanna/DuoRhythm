<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPlatformBadge"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_squircle_action"
                android:padding="9dp"
                android:src="@drawable/ic_contacts"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvContactName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Contact Name"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvContactRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_role_pill_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        tools:text="Lab Partner"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvContactNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="Notes or contact info"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDeleteContact"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- 1-Tap Communication Actions Row -->
        <LinearLayout
            android:id="@+id/layoutContactActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 1-Tap Phone Call -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionCall"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="6dp"
                android:text="Call"
                app:icon="@drawable/ic_phone"
                app:iconSize="14dp"
                app:iconTint="@color/text_primary"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/surface_variant"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

            <!-- 1-Tap WhatsApp -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionWhatsApp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="6dp"
                android:text="WhatsApp"
                app:icon="@drawable/ic_chat"
                app:iconSize="14dp"
                app:iconTint="#34D399"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#064E3B"
                app:strokeColor="#059669"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

            <!-- 1-Tap Telegram -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionTelegram"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="6dp"
                android:text="Telegram"
                app:icon="@drawable/ic_telegram"
                app:iconSize="14dp"
                app:iconTint="#38BDF8"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#0C4A6E"
                app:strokeColor="#0284C7"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

            <!-- Fallback Open Button if not phone/wa/tg -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenContactLink"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Open ➜"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:visibility="gone"
                app:strokeColor="#0284C7"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
