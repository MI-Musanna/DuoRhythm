<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_dark"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Export Assessments"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#0B1120"
        app:cardCornerRadius="12dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivExamThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Live Exam Preview" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchOnlyPendingExams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="Include Only Pending Items"
        android:textColor="#E2E8F0"
        android:textSize="14sp"
        app:useMaterialThemeColors="true" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupExamCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:chipSpacing="6dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCatCT"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="CT/Quiz"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="@color/bg_chip_selector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCatMidterm"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Midterms"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="@color/bg_chip_selector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCatFinals"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Finals"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="@color/bg_chip_selector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCatAssignment"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Assignment"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="@color/bg_chip_selector" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchExamFormatJpeg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:checked="false"
        android:text="Save as lightweight JPEG (.jpg)"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        app:useMaterialThemeColors="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelExamExport"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            android:textColor="#94A3B8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareExams"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:strokeColor="#F59E0B"
            android:text="SHARE"
            android:textColor="#F59E0B" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveExams"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:backgroundTint="#F59E0B"
            android:text="SAVE"
            android:textColor="#0F172A"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
