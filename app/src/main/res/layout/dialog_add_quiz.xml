<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvQuizDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Schedule Class Test / Quiz"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQuizDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Assign course, date, room, and syllabus for this class test/quiz."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Subject Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Select Enrolled Subject"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spQuizSubject"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp" />

    <!-- Quiz Title -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilQuizTitle"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:boxBackgroundColor="@color/surface_variant"
        app:boxStrokeColor="@color/card_stroke_bright"
        android:hint="e.g. Class Test 1, Quiz 2">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuizTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Date & Time Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            app:boxBackgroundColor="@color/surface_variant"
            app:boxStrokeColor="@color/card_stroke_bright"
            android:hint="Date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuizDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOutline" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            app:boxBackgroundColor="@color/surface_variant"
            app:boxStrokeColor="@color/card_stroke_bright"
            android:hint="Time (Optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuizTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOutline" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Room / Hall -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:boxBackgroundColor="@color/surface_variant"
        app:boxStrokeColor="@color/card_stroke_bright"
        android:hint="Room / Hall / Location (e.g. Room 402)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuizRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Syllabus & Notes -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:boxBackgroundColor="@color/surface_variant"
        app:boxStrokeColor="@color/card_stroke_bright"
        android:hint="Syllabus / Topics / Notes (Optional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuizNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveQuiz"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:text="Schedule Class Test"
        app:cornerRadius="12dp" />

</LinearLayout>
