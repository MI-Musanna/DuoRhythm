<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass_oled"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvWhatsNewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What's New ✨"
        android:textColor="#F8FAFC"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Live Release Notes Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="80dp">

        <ProgressBar
            android:id="@+id/pbLoadingReleaseNotes"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF" />

        <TextView
            android:id="@+id/tvWhatsNewBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="#94A3B8"
            android:textSize="12.5sp"
            android:visibility="gone" />
    </FrameLayout>

    <CheckBox
        android:id="@+id/cbDontShowAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:buttonTint="#00E5FF"
        android:text="Don't show this again"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismissWhatsNew"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#00E5FF"
        android:text="AWESOME!"
        android:textColor="#06080F"
        android:textSize="12.5sp"
        android:textStyle="bold"
        app:cornerRadius="22dp" />
</LinearLayout>