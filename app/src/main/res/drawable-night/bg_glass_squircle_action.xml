<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2600F2FE">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#182A45"
                android:centerColor="#111F33"
                android:endColor="#0B1524" />
            <stroke
                android:width="1dp"
                android:color="#3300F2FE" />
        </shape>
    </item>
</ripple>
