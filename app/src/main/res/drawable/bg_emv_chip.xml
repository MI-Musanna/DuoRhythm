<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <gradient
                android:angle="45"
                android:startColor="#E6C875"
                android:centerColor="#D4AF37"
                android:endColor="#AA820A" />
            <stroke
                android:width="1dp"
                android:color="#8A6708" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:left="6dp"
        android:right="6dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <stroke
                android:width="1dp"
                android:color="#8A6708" />
        </shape>
    </item>
</layer-list>
