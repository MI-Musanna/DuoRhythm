<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#2600F2FE"
                android:centerColor="#260284C7"
                android:endColor="#261E40AF" />
            <stroke
                android:width="1.5dp"
                android:color="#4D00F2FE" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1500F2FE"
                android:endColor="#0A182B" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
