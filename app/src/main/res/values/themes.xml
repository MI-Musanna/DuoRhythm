<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DuoRhythm" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Unified System Bar Colors App-Wide -->
        <item name="android:statusBarColor">#0A1322</item>
        <item name="android:navigationBarColor">#06080F</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowBackground">@color/bg_root_obsidian</item>
        <item name="android:colorBackground">@color/bg_root_obsidian</item>

        <!-- Base Surface Tokens -->
        <item name="colorSurface">@color/surface_card_slate</item>
        <item name="colorPrimary">@color/accent_cyan_primary</item>
        <item name="colorSecondary">@color/accent_cyan_glow</item>
        <item name="colorControlNormal">@color/text_secondary_slate</item>
        <item name="colorControlActivated">@color/accent_cyan_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_slate</item>
        <item name="colorOnSurface">@color/text_primary_white</item>

        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialog</item>
        <item name="materialCardViewStyle">@style/CardElevationRounded</item>
        <item name="android:textViewStyle">@style/DuoRhythmTextView</item>
        <item name="android:editTextStyle">@style/DuoRhythmEditText</item>
        <item name="editTextStyle">@style/DuoRhythmEditText</item>
    </style>

    <style name="Theme.LifeSync" parent="Theme.DuoRhythm" />

    <style name="DuoRhythmTextView" parent="android:Widget.TextView">
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">true</item>
    </style>

    <style name="DuoRhythmEditText" parent="android:Widget.EditText">
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <style name="CardElevationRounded" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_glass_stroke</item>
        <item name="cardBackgroundColor">@color/surface_card_slate</item>
    </style>

    <style name="GlassPillButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">999dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_glass_stroke</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/surface_card_slate</item>
    </style>

    <style name="Widget.DuoRhythm.BottomNavText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
</resources>
